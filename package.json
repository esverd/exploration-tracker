{
  "name": "exploration-tracker",
  "version": "1.0.0",
  "description": "A configurable web app to track your explorations - countries visited, US states, and more",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "npm run build && node server/index.js",
    "start": "node server/index.js"
  },
  "keywords": [
    "exploration",
    "tracker",
    "travel",
    "map",
    "countries",
    "states"
  ],
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
